SECRET_KEY=your-secret-key

DEBUG=True

DB_NAME=football_blog
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: live chat channel layer. Leave unset to use the in-memory
# layer (fine for a single dev process). Set this in production so
# multiple workers can share chat messages, e.g. redis://localhost:6379
REDIS_URL=

# Production only: enable once HTTPS is configured in front of the app.
# Leave unset/False for local HTTP dev.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0