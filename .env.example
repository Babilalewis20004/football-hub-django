SECRET_KEY=your-secret-key

DEBUG=True

DB_NAME=football_blog
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Only used when running via Docker Compose, to initialize the postgres
# container itself (see docker-compose.yml). DB_NAME/DB_USER/DB_PASSWORD
# above are what Django actually connects with — these three MUST match
# them exactly, or Django and the database container will disagree on
# credentials. DB_HOST/DB_PORT above are not used in Docker: Compose
# overrides them to the "postgres" service hostname automatically, so
# they can stay as "localhost" here for running the app natively.
POSTGRES_DB=football_blog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password

ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: live chat channel layer. Leave unset to use the in-memory
# layer (fine for a single dev process). Set this in production so
# multiple workers can share chat messages, e.g. redis://localhost:6379
# (Docker Compose overrides this automatically to redis://redis:6379/0 —
# see docker-compose.yml — so it can stay blank here for Docker use.)
REDIS_URL=

# Production only: enable once HTTPS is configured in front of the app.
# Leave unset/False for local HTTP dev.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Optional: announces newly published posts to a Telegram channel.
# Leave both unset to disable. Get a token from @BotFather, add the bot
# as admin on the channel, and use the channel's @username or numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
